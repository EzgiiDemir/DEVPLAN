{
  "name": "devplan-companion",
  "version": "0.1.0",
  "private": true,
  "description": "DevPlan Companion — local agent that lets DevPlan Studio check your installed tools, create real project folders, and run real terminal commands on your machine.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/**/*.test.js\"",
    "dist": "electron-builder"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "cross-spawn": "^7.0.6",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.devplan.companion",
    "productName": "DevPlan Companion",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": "AppImage",
      "category": "Development"
    }
  }
}
